PS1="\[\033[01;32m\]\w$ \[\033[0m\]"
export ISAACPATH="$HOME/.local/share/ov/pkg/isaac-sim-2023.1.1"
export GUBOKIT="$HOME/Gubo-kit"

source "/opt/ros/humble/setup.bash"

source "$GUBOKIT/ros_ws/install/setup.bash"
export ROS_LOCALHOST_ONLY=1
export PYTHONPATH="${PYTHONPATH}:$GUBOKIT"

alias gu_edit="code $GUBOKIT/.bashgu"

# vscode source automatically source only if it's not sourced (in a terminal)
if [[ -z "$VIRTUAL_ENV" ]]; then
  source ~/pyenv/bin/activate
fi

alias gu_py="python3 -i $GUBOKIT/gubokit/py_test_env.py"

export PYTHONPATH="${PYTHONPATH}:$HOME/fluently_ws/hfc-thrift/src/main/python/src"
export QT_QPA_PLATFORM=xcb

alias isaac="cd $ISAACPATH && ./isaac-sim.sh"

alias fluently_thrift="cd $HOME/fluently_ws && ./hfc-thrift/bin/startServer.sh -p 7070 fluently_ontology/fluently.yml"

git_paths=(
          "$HOME/knowledge-transfer-fleuntly"
          "$HOME/Gubo-kit"
          "$HOME/fluently_ws/fluently_mem"
          "$HOME/fluently_ws/ros/supsi-pa"
          "$HOME/Project_cdt"
          )

isaac_py(){
     cd $ISAACPATH
     ./python.sh $*
     }
lazy_git(){
     git add .
     git commit -m "$*"
     git push
     }
lazy_git_pull(){
     for dir in "${git_paths[@]}"; do
          echo "== $(basename "$dir") =="
          (cd $dir && git pull --no-stat)
     done
}
lazy_git_status(){
     for dir in "${git_paths[@]}"; do
          echo "== $(basename "$dir") =="
          (cd $dir && git status -sb)
     done
}


