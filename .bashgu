PS1="\[\033[01;32m\]\w$ \[\033[0m\]"
export ISAACPATH="$HOME/.local/share/ov/pkg/isaac-sim-2023.1.1"
export GUBOKIT="$HOME/Gubo-kit"
export GUBOKITCPP="$HOME/Gubo-kit-Cpp"


ros_paths=(
          "/opt/ros/humble/setup.bash"
          "/opt/ros/jazzy/setup.bash"
          )

# for path in "${ros_paths[@]}"; do
#      if [ -f "$path" ]; then
#           source $path
#      fi
# done

# source "$GUBOKIT/ros_ws/install/setup.bash"
export ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
export PYTHONPATH="${PYTHONPATH}:$GUBOKIT"

alias gu_edit="code $GUBOKIT/.bashgu"

# vscode source automatically source only if it's not sourced (in a terminal)
source ~/pyenv/bin/activate
# if [[ -z "$VIRTUAL_ENV" ]]; then
#   source ~/pyenv/bin/activate
# fi

alias gu_py="python3 -i $GUBOKIT/gubokit/py_test_env.py"

export PYTHONPATH="${PYTHONPATH}:$HOME/fluently_ws/hfc-thrift/src/main/python/src"
export QT_QPA_PLATFORM=xcb

alias isaac="cd $ISAACPATH && ./isaac-sim.sh"
alias blender="cd $HOME/blender-4.4.3-linux-x64 && ./blender"

alias fluently_thrift="cd $HOME/fluently_ws && ./hfc-thrift/bin/startServer.sh -p 7070 fluently_ontology/fluently.yml"
alias mem_thrift="cd $HOME/fluently_ws && ./hfc-thrift/bin/run_server -p 7070 fluently-sdu/src/main/resources/ontology/fluently.yml"

alias start_jazzy_docker="docker run -it --rm --name ros2_jazzy_dev -u "$(id -u)":"$(id -g)" -v /home/gu/Gubo-kit-Cpp/ros2_ws:/ros_ws -w /ros_ws my_ros_jazzy:dev bash"
alias start_jazzy_terminal="docker exec -it ros2_jazzy_dev bash"
alias commit_jazzy_docker="docker commit ros2_jazzy_dev my_ros_jazzy:dev"

git_paths=(
          "$HOME/Gubo-kit-Cpp"
          "$HOME/Gubo-kit"
          )

isaac_py(){
     cd $ISAACPATH
     ./python.sh $*
     }
lazy_git(){
     git add .
     git commit -m "$*"
     git push
     }
lazy_git_pull(){
     for dir in "${git_paths[@]}"; do
          if [ -d "$dir" ]; then 
               echo "== $(basename "$dir") =="
               (cd $dir && git pull --no-stat)
          fi
     done
}
lazy_git_status(){
     for dir in "${git_paths[@]}"; do
          if [ -d "$dir" ]; then 
               echo "== $(basename "$dir") =="
               (cd $dir && git status -sb)
          fi
     done
}

# for c++
# source "$GUBOKITCPP/ros2_ws/install/setup.bash" 

gubo_build_and_run(){
     cmake --build build
     ./build/"$*"
}