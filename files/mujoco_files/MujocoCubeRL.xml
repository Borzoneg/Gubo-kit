<mujoco model="moveable_env" >
    <asset>
        <texture name="grid" type="2d" builtin="checker" rgb1=".1 .2 .3"
        rgb2=".2 .3 .4" width="300" height="300" mark="edge" markrgb=".2 .3 .4"/>
        <material name="grid" texture="grid" texrepeat="2 2" texuniform="true"
        reflectance="0"/>
    </asset>
    <compiler angle="degree" coordinate="local" />
    <option gravity="0 0 -9.81" />

    <size njmax="1000" nconmax="100" />

    <visual>
        <global offwidth="1920"/>
    </visual>
    <visual>
        <global offheight="1080"/>
    </visual>

    <worldbody>
        <geom name="ground" type="plane" pos="0 0 0" size="10 10 .1" material="grid"/>
        <camera name="top" pos="0 -20 18" euler="45 0 0"/>

        <!-- Free moving cube -->
        <body name="agent" pos="0 0 0.1">
            <freejoint name="agentjoint" />
            <geom type="box" size="0.1 0.1 0.1" rgba="0.8 0.1 0.1 1"/>
            <inertial pos="0 0 0" mass="1" diaginertia="0.01 0.01 0.01"/>
        </body>


        <!-- Target -->
        <body name="target" mocap="true" pos="0 0 0.01">
            <geom type="box" size="0.2 0.2 0.01" rgba="0 1 0 1"/> 
        </body>

        <!-- Four movable walls -->
        <body name="wally1" mocap="true" pos="0 -10 1">
            <geom type="box" size="10 0.1 1" rgba="0.2 0.2 0.8 1"/>
        </body>
        <body name="wally2" mocap="true" pos="0 10 1">
            <geom type="box" size="10 0.1 1" rgba="0.2 0.2 0.8 1"/>
        </body>
        <body name="wallx1" mocap="true" pos="-10 0 1">
            <geom type="box" size="0.1 10 1" rgba="0.2 0.2 0.8 1"/>
        </body>
        <body name="wallx2" mocap="true" pos="10 0 1">
            <geom type="box" size="0.1 10 1" rgba="0.2 0.2 0.8 1"/>
        </body>
    </worldbody>

    <actuator>
        <!-- actuators can be added here if needed -->
    </actuator>
    </mujoco>
