<mujoco model="moveable_env" >
  <compiler angle="degree" coordinate="local" />
  <option gravity="0 0 -9.81" />

  <size njmax="1000" nconmax="100" />

  <!-- Floor grid, fixed -->
  <worldbody>
    <body name="floor" pos="0 0 0">
      <geom name="floor_geom" type="plane" size="5 5 0.1" rgba="0.7 0.7 0.7 1"/>
    </body>

    <!-- Free moving cube -->
    <body name="agent" pos="0 0 0.2">
      <freejoint />
      <geom type="box" size="0.1 0.1 0.1" rgba="0.8 0.1 0.1 1"/>
      <inertial pos="0 0 0" mass="1" diaginertia="0.01 0.01 0.01"/>
    </body>

    <!-- Target, fixed in place -->
    <body name="target" pos="0 0 0.05">
      <geom type="box" size="0.2 0.2 0.01" rgba="0 1 0 1" contype="0" conaffinity="0"/> 
      <!-- contype/conaffinity=0 disables collision -->
    </body>

    <!-- Four movable walls -->
    <body name="wally1" pos="0 -2 0.5">
      <geom type="box" size="10 0.1 1" rgba="0.2 0.2 0.8 1"/>
    </body>
    <body name="wally2" pos="0 2 0.5">
      <geom type="box" size="10 0.1 1" rgba="0.2 0.2 0.8 1"/>
    </body>
    <body name="wallx1" pos="-2 0 0.5">
      <geom type="box" size="0.1 10 1" rgba="0.2 0.2 0.8 1"/>
    </body>
    <body name="wallx2" pos="2 0 0.5">
      <geom type="box" size="0.1 10 1" rgba="0.2 0.2 0.8 1"/>
    </body>
  </worldbody>

  <actuator>
    <!-- actuators can be added here if needed -->
  </actuator>
</mujoco>
